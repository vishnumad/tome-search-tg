{
  "name": "tome-search-tg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot that searches Hardcover for books",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env src/main.ts",
    "dev": "node --env-file=.env --watch src/main.ts",
    "search": "node --env-file=.env src/cli.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "schema": "node --env-file=.env scripts/generate-schema.ts"
  },
  "dependencies": {
    "gql.tada": "^1.11.3",
    "grammy": "^1.46.0",
    "graphql": "^16.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3"
  }
}
